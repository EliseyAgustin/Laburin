# Copiar a .env.e2e (NO se commitea). Cuentas de prueba para la suite de Playwright.
# Se crean solas por el flujo de registro de la app la primera vez que corre la suite.
E2E_EMAIL=nombre.apellido.1234@gmail.com
E2E_EMAIL_MOBILE=otro.nombre.5678@gmail.com
E2E_PASSWORD=una-contraseña-larga-de-prueba
# Cuenta de administrador para las pruebas de roles y mensajes: registrarla desde la app y asignarle el rol una
# sola vez por SQL (insert into public.roles_usuario ...). Los tests solo inician sesión con ella.
E2E_ADMIN_EMAIL=admin.pruebas@gmail.com
E2E_ADMIN_PASSWORD=una-contraseña-larga-de-prueba
# VITE_SUPABASE_URL y VITE_SUPABASE_ANON_KEY se leen de .env (sin service role key: todo corre con RLS).
